# Environment and secrets
.env
.env.*
!.env.example

# Dependencies and build outputs
node_modules/
dist/
build/

# Python runtime artifacts
__pycache__/
*.py[cod]
.venv/
venv/

# Local IDE / OS files
.DS_Store
.vs/
.vscode/

# Generated or sensitive demo/runtime data
backend/reports/
backend/data/*.db
backend/data/*.db.*
backend/data/eap_exports/

# Office exports often contain author metadata
*.docx
*.xlsx
*.pptx

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
