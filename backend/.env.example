# ============================================================
# Credit-Lens 後端設定(複製本檔為 .env 後填寫)
# 注意:註解一律獨立成行,不要寫在設定值後面(會被當成值讀進去)
# ============================================================

# --- 精誠 EAP 平台(Gemini Enterprise API v1)---
# 官方流程:POST {BASE}/chat/create → chat_id → POST {BASE}/chat/{chat_id}
EAP_API_BASE=https://cloud.geminidata.com/api/v1

# 大會控制台取得的 Token(eyJ 開頭)。注意:目前核發的 Token 有效期僅 24 小時
EAP_TOKEN=

# 專案識別碼(大會控制台取得)
EAP_PROJECT_ID=

# 租戶識別。留空(建議)則自 Token 的 g_tid 自動解析
EAP_TENANT=

# 除錯:設為 true 會在後端 console 印出 EAP 的原始回應(排查格式問題用)
EAP_DEBUG=false

# --- 執行模式 ---
# false = 直接呼叫 EAP(預設);true = 一律回範例 JSON
MOCK_MODE=false

# true = EAP 失敗時自動降級回範例 JSON(Demo 保險絲)
# false = 回傳錯誤讓前端顯示重試(開發期建議)
FALLBACK_ON_ERROR=true

# true = 情資查詢直接打政府開放資料(預設)
OPEN_DATA=true

# --- 專利檢索 ---
# 三層自動降級:TIPO API(需驗證碼)→ Google Patents 即時查詢(免金鑰)→ 一鍵檢索連結(永遠可用)
# 健檢:python check_patents.py 公司名稱

# TIPO GPSS 驗證碼(免費)。申請:https://tiponet.tipo.gov.tw/gpss1/ → 使用說明 → API 驗證碼線上申請
TIPO_API_KEY=
# 端點預設 https://tiponet.tipo.gov.tw/gpss1/gpsskmc/gpss_api;與核發文件不同時再覆寫
TIPO_API_URL=
# 檢索資料庫,預設 TWA,TWB(本國公開+公告);依需求可加 USA,USB 等
TIPO_PATDB=

# Google Patents 即時查詢(官方網頁自用端點,非公開 API)。false = 只留一鍵檢索連結
GOOGLE_PATENTS_LIVE=true

# --- CORS ---
# 逗號分隔;Demo 前改成 Vercel 網址
ALLOW_ORIGINS=http://localhost:5173

# ============================================================
# 外部資料源全部免金鑰:商工登記 / TWSE / 食藥署 / Google News
# Demo 前請先執行 python prefetch.py 建立本地快取
# ============================================================

# --- Demo 成功結果快取(強烈建議使用)---
# EAP 平台回應不穩,現場不能賭。平時測試用 record 累積成功結果,Demo 當天改 replay 全程重播。
#   off    = 不使用快取,每次都真打 EAP
#   record = 真打 EAP,成功才存檔(預設;平時測試就在累積素材)
#   replay = 優先讀存好的結果,秒回且必成功(Demo 當天用)
# 批次預熱:python warmup.py --all      盤點:python -c "import cache_store,json;print(json.dumps(cache_store.coverage(),ensure_ascii=False,indent=2))"
CACHE_MODE=record
